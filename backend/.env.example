APP_ENV=development
DATABASE_URL=sqlite:///./urchart.db
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Generate separate random tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_AUTH_ENABLED=false
# Map generated secret bearer tokens to stable synthetic user names. Never commit actual tokens.
DEMO_TOKENS={}
# disabled or approved_instructions. No external provider is enabled in this foundation.
AI_PROVIDER=disabled
AI_API_KEY=
# Optional server-controlled JSON rule file. Empty uses labeled prototype rules.
# Prototype rules cannot evaluate in production; unavailable assessments carry safety guidance.
RISK_RULES_FILE=
